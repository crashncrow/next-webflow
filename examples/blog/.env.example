# Copy to .env.local and fill in. Never commit .env.local.
# Site token with CMS: Read (Site settings → Apps & integrations → API access).
WEBFLOW_CMS_TOKEN=
WEBFLOW_SITE_ID=
# Written by `npx next-webflow webhooks register --url https://<your-site>/api/webflow` (comma-separated).
WEBFLOW_WEBHOOK_SECRET=
# Long random strings, e.g. `openssl rand -hex 32`.
WEBFLOW_PREVIEW_SECRET=
DRAFTS_PASSWORD=
# Optional: the public URL, for absolute link-preview (Open Graph) images. Not needed on Vercel.
NEXT_PUBLIC_SITE_URL=
# Demo only: lets any visitor preview posts' unpublished drafts ("Try draft preview").
# Leave unset on a real site: editors use the password-protected /drafts page.
DEMO_PUBLIC_PREVIEWS=
