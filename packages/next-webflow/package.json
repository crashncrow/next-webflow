{
  "name": "next-webflow",
  "version": "0.0.0",
  "description": "Use the Webflow CMS as a headless content source in Next.js: types, caching, revalidation, previews, and rendering.",
  "license": "MIT",
  "author": "Diego Gennaro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crashncrow/next-webflow.git",
    "directory": "packages/next-webflow"
  },
  "homepage": "https://github.com/crashncrow/next-webflow/tree/main/packages/next-webflow#readme",
  "bugs": {
    "url": "https://github.com/crashncrow/next-webflow/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "default": "./dist/webhook.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "default": "./dist/draft.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    },
    "./components/client": {
      "types": "./dist/components-client.d.ts",
      "default": "./dist/components-client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "test": "vitest run --project node --project edge",
    "test:edge": "vitest run --project edge",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:contract": "vitest run --project contract",
    "fixtures:update": "node scripts/update-fixtures.ts"
  },
  "keywords": [
    "webflow",
    "webflow-cms",
    "nextjs",
    "next",
    "cms",
    "headless-cms",
    "app-router",
    "revalidation",
    "webhooks",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "msw": "^3.0.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "bin": {
    "next-webflow": "./dist/cli.mjs"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "html-dom-parser": "^8.0.2",
    "html-react-parser": "^6.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
