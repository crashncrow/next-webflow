{
  "name": "next-webflow",
  "version": "0.0.0",
  "description": "Use the Webflow CMS as a headless content source in Next.js: types, caching, revalidation, previews, and rendering.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --project node --project edge",
    "test:edge": "vitest run --project edge",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:contract": "vitest run --project contract",
    "fixtures:update": "node scripts/update-fixtures.ts"
  },
  "keywords": [
    "webflow",
    "nextjs",
    "cms",
    "headless",
    "revalidation"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "msw": "^3.0.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
