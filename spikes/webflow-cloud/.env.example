# Local copy: .env.local (git-ignored). On Webflow Cloud, set these as environment variables
# (mark tokens and SPIKE_SECRET as "Secret"). TEST SITE ONLY.

# Read-only token (CMS: read, Sites: read). Used by the deployed app.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
# Protects the revalidate endpoints. Any random string.
SPIKE_SECRET=

# Local scripts only (never on Webflow Cloud): token with CMS write, used by `npm run seed`.
WEBFLOW_WRITE_TOKEN=
# Must equal WEBFLOW_SITE_ID: a guard so the seed script can't write to the wrong site.
SEED_CONFIRM_SITE_ID=
