# Copy to local.env (git-ignored). TEST SITE ONLY.
#
# NOT named .env*: don't rely on .env* files for secrets when deploying. Upload these to Webflow
# Cloud as encrypted secrets instead:
#   webflow apps env-vars import local.env --secret
#
# Read-only site token (CMS: Read, Sites: Read). Used by the deployed app, and by builds
# (export it in the deploy shell: the CLI builds locally without Cloud's env vars).
# Not WEBFLOW_API_TOKEN: the Webflow CLI reads that name for its own (workspace) token.
WEBFLOW_CMS_TOKEN=
WEBFLOW_SITE_ID=
# Protects the revalidate endpoints. Any random string.
SPIKE_SECRET=
# Signs draft-mode preview links (npx next-webflow preview-url). Any long random string.
WEBFLOW_PREVIEW_SECRET=
# Basic auth for the internal /drafts page (README example). Long random string.
DRAFTS_PASSWORD=
# Webflow Cloud mount path (Webflow docs: set it yourself).
NEXT_PUBLIC_BASE_PATH=/spike
