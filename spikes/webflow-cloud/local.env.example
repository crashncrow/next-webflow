# Copy to local.env (git-ignored). TEST SITE ONLY.
#
# NOT named .env*: `webflow apps deploy` builds locally and OpenNext bakes every .env* file into the
# worker bundle in plain text. Upload these to Webflow Cloud as encrypted secrets instead:
#   webflow apps env-vars import local.env --secret
#
# Read-only token (CMS: read, Sites: read). Used by the deployed app.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
# Protects the revalidate endpoints. Any random string.
SPIKE_SECRET=
