{
  "name": "next-webflow-cloud-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=local.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "pack-lib": "node scripts/pack-lib.mjs",
    "seed": "node --env-file=local.env --env-file=seed.env scripts/seed.mjs",
    "snapshot-schema": "node --env-file=local.env scripts/snapshot-schema.mjs",
    "check-env": "node scripts/check-no-env.mjs",
    "deploy": "node scripts/check-no-env.mjs && node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\" && webflow apps deploy",
    "measure": "node --env-file=local.env scripts/measure-cache.mjs",
    "watch": "node --env-file=local.env scripts/watch-e2e.mjs",
    "api-edit-live": "node --env-file=local.env --env-file=seed.env scripts/api-edit-live.mjs",
    "webhooks": "node --env-file=seed.env node_modules/next-webflow/dist/cli.mjs webhooks --env-file local.env --token-env WEBFLOW_ADMIN_TOKEN",
    "api-create-live": "node --env-file=local.env --env-file=seed.env scripts/api-create-live.mjs",
    "measure-load": "node --env-file=local.env scripts/measure-load.mjs",
    "never-published": "node --env-file=local.env --env-file=seed.env scripts/never-published.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "next": "16.4.2",
    "next-webflow": "file:vendor/next-webflow.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
