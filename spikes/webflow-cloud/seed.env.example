# Copy to seed.env (git-ignored). Local only, NEVER uploaded to Webflow Cloud. TEST SITE ONLY.
# Used by `npm run seed` together with local.env.
#
# Token with CMS write.
WEBFLOW_WRITE_TOKEN=
# Must equal WEBFLOW_SITE_ID: a guard so the seed script can't write to the wrong site.
SEED_CONFIRM_SITE_ID=
